# ==============================================================================
# LOCK IN AI — Environment Variables Template (.env.example)
# Copy this file to .env and fill in your actual credentials.
# DO NOT commit .env to version control!
# ==============================================================================

# ── AI & LLM Providers ────────────────────────────────────────────────────────
IBM_API_KEY=
IBM_PROJECT_ID=
IBM_URL=https://us-south.ml.cloud.ibm.com
GROQ_API_KEY=
GOOGLE_API_KEY=
TAVILY_API_KEY=
NEWS_API_KEY=

# ── Supabase & PostgreSQL Database ────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
DATABASE_URL=
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=
DB_PASSWORD=

# ── HuggingFace & ChromaDB Vector Store ────────────────────────────────────────
HF_TOKEN=
HF_CHROMA_REPO=sahilsks/startup-blueprint-chroma-db
CHROMA_LOCAL_PATH=/app/chroma_db

# ── Google OAuth & Gmail Accountability Agent ─────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/lock-in/gmail/callback

# ── Application & Runtime Configuration ───────────────────────────────────────
ENVIRONMENT=production
FRONTEND_URL=http://localhost
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173
PORT=8000
